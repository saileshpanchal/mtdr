      "locator": {
        "kind": "char-offset",
        "start": 398,
        "end": 507,
        "line_start": 9,
        "line_end": 10
      },
      "content": "Rounds have been stable and crews prefer the shorter yard exit at Northgate, so we have not\nscheduled a move.",
      "source_time": "2026-06-30",
      "observed_at": "2026-11-07",
      "observed_by": {
        "name": "adopter-trial",
        "version": "1"
      }
    },
    {
      "fragment_id": "brackwell-S06-F5",
      "source_ref": "sources/brackwell/SRC-06-ops-note-2026-06-30.md",
