        "kind": "char-offset",
        "start": 509,
        "end": 598,
        "line_start": 12,
        "line_end": 12
      },
      "content": "Northgate has been included in the depot maintenance schedule through FY28 on that basis.",
      "source_time": "2026-06-30",
      "observed_at": "2026-11-07",
      "observed_by": {
        "name": "adopter-trial",
        "version": "1"
      }
