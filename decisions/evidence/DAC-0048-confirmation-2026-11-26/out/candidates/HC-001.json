      }
    },
    {
      "fragment_id": "F02-BG",
      "source_ref": "SRC-02-oic-paper-hms-replacement.md",
      "source_hash": "sha256:6c7bdc740a8099819fa14c244ad82e7947e5c5d3e04eb685411ef4807632021a",
      "locator": {
        "kind": "char-offset",
        "start": 302,
        "end": 572
      },
      "content": "Orchard (supplied by Calder Software) has been in use since 2014. Calder will stop supporting the current version when the licence ends on 30 September 2026. Repairs, rents, tenancy and complaints records all sit in Orchard, and there are 31 interfaces to other systems.",
      "source_time": "2026-03-26",
      "observed_at": "2026-11-26",
      "observed_by": {
        "name": "Claude (AI agent) executing mtdr-decision/recover-decision-records",
        "version": "claude-fable-5-2"
      }
    },
    {
      "fragment_id": "F02-OPT-A",
      "source_ref": "SRC-02-oic-paper-hms-replacement.md",
      "source_hash": "sha256:6c7bdc740a8099819fa14c244ad82e7947e5c5d3e04eb685411ef4807632021a",
      "locator": {
        "kind": "char-offset",
        "start": 597,
        "end": 730
      },
      "content": "- A. Extend Orchard on a rolling basis. Calder have said this is possible only for short periods and at rising cost. Not recommended.",
      "source_time": "2026-03-26",
      "observed_at": "2026-11-26",
      "observed_by": {
        "name": "Claude (AI agent) executing mtdr-decision/recover-decision-records",
        "version": "claude-fable-5-2"
      }
    },
    {
