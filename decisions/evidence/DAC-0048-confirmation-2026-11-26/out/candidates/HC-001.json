    {
      "fragment_id": "F02-REC",
      "source_ref": "SRC-02-oic-paper-hms-replacement.md",
      "source_hash": "sha256:6c7bdc740a8099819fa14c244ad82e7947e5c5d3e04eb685411ef4807632021a",
      "locator": {
        "kind": "char-offset",
        "start": 1649,
        "end": 1873
      },
      "content": "The Committee is asked to:\n1. approve the award of a five-year contract to Vantry Systems Ltd;\n2. note the implementation call-off and contingency;\n3. note that the Orchard extension will be arranged by the Finance Director.",
      "source_time": "2026-03-26",
      "observed_at": "2026-11-26",
      "observed_by": {
        "name": "Claude (AI agent) executing mtdr-decision/recover-decision-records",
